# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Indexer
INDEXER_ROLE=hexa          # hexa (WebSocket, factory + curves) | network (full-chain scan)
INDEXER_PORT=8880
HEXA_STATE_DIR=data-hexa
START_BLOCK=0              # 0 = start BACKFILL_BLOCKS behind head
RECONCILE_MS=30000         # how often the hexa role re-reads cursor..head

# Contracts (fill after deploy — written to deployments/<chainId>.json)
HEXA_FACTORY_ADDRESS=

# Launch defaults, applied to every new coin. See docs/CURVE.md.
GUARD_BLOCKS=300
TAX_BLOCKS=3000
MAX_BUY_BPS=50             # 0.5% of supply per wallet during the guard window
SELL_TAX_START_BPS=9000
SELL_TAX_FLOOR_BPS=100
CREATOR_MAX_BPS=10000     # 10000 = no cap. Only 79.31% of supply is ever sellable.

# On Arc MAINNET set this to Uniswap's canonical factory so no parallel v3 is deployed.
# Leave empty on testnet and the deploy script ships a fixture. docs/CURVE.md §5.
V3_FACTORY=

# Deployer — NEVER commit a real key. Fund it at https://faucet.circle.com
PRIVATE_KEY=
